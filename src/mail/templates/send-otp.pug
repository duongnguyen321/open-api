doctype html
html
    head
        meta(charset="UTF-8")
        title Your One-Time Password, #{name} (#{otp})
        style.
            body {
                font-family: Arial, sans-serif;
                background-color: #000;
                color: #fff;
                text-align: center;
                padding: 20px;
                margin: 0;
            }

            .container {
                margin: 0 auto;
                padding: 20px;
                border: 1px solid #444;
                border-radius: 8px;
                background-color: #111;
                max-width: 600px;
                box-shadow: 0 0 15px rgba(255, 255, 255, 0.2);
            }

            h1 {
                color: #ffd700;
            }

            p {
                line-height: 1.6;
                color: #ccc;
            }

            .otp-code {
                background-color: #222;
                border: 1px dashed #ffd700;
                padding: 15px 20px;
                margin: 30px auto;
                font-size: 28px;
                font-weight: bold;
                letter-spacing: 5px;
                color: #fff;
                display: inline-block;
                border-radius: 5px;
            }

            .footer-text {
                font-size: 12px;
                color: #777;
                margin-top: 20px;
            }

            .logo-img {
                margin: 20px 0;
                max-width: 150px;
                height: auto;
            }
    body
        .container
            h1 Your One-Time Password
            p Hi #{name},
            p Please use the following One-Time Password (OTP) to complete your action.

            //- The main OTP code block
            .otp-code #{otp}

            p This code is valid for the next <strong>#{validityPeriod}</strong>.

            p.footer-text For your security, please do not share this code with anyone. If you did not request this, you can safely ignore this email.

            p
                | Thank you,
                br
                | OTP generated and secured by <a href="https://codetails.site" target="_blank" style="color: #ffd700;">CodeTails</a>

            img.logo-img(src=trackingUrl, alt=`Tracking Logo`)
